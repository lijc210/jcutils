[
  {
    // ==========================================
    // 1. 基本信息
    // ==========================================

    // 任务名称
    "label": "Python: Run Module [jcutils]",

    // Python 解释器：使用项目虚拟环境
    "command": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",

    // 运行参数
    // -m：以模块方式运行
    // 使用 Python 扩展提供的当前模块名称
    "args": [
      "-m",
      "$ZED_CUSTOM_PYTHON_MODULE_NAME"
    ],

    // 工作目录：项目根目录
    "cwd": "$ZED_WORKTREE_ROOT",


    // ==========================================
    // 2. 环境变量
    // ==========================================

    // 这些变量会追加到任务运行环境中
    "env": {
      // Python 模块搜索路径
      "PYTHONPATH": ".",

      // 运行环境
      "MY_ENV": "dev",

      // API 密钥
      "API_KEY": "your-api-key",

      // 日志级别
      "LOG_LEVEL": "INFO",

      // 调试模式
      "DEBUG": "1"
    },


    // ==========================================
    // 3. Runnable 绑定
    // ==========================================

    // 绑定 Python Run Module 行内运行按钮
    "tags": [
      "python-module-main-method"
    ],


    // ==========================================
    // 4. Shell 配置
    // ==========================================

    // system：使用系统默认终端 Shell
    // 也支持指定 program 或 with_arguments
    "shell": "system",


    // ==========================================
    // 5. 终端管理
    // ==========================================

    // 是否新建终端标签
    // true：每次运行新建
    // false：复用现有终端
    "use_new_terminal": false,

    // 是否允许相同任务并发运行
    // true：允许并发
    // false：等待之前的任务结束
    "allow_concurrent_runs": false,


    // ==========================================
    // 6. 终端显示行为
    // ==========================================

    // 任务启动时的终端显示方式
    // always：显示并切换焦点
    // no_focus：显示但不切换焦点
    // never：不改变焦点和显示状态
    "reveal": "always",

    // 任务结束后的终端处理方式
    // never：不隐藏
    // always：隐藏任务标签
    // on_success：成功时隐藏
    "hide": "never",


    // ==========================================
    // 7. 输出控制
    // ==========================================

    // 是否显示任务执行摘要
    "show_summary": true,

    // 是否显示执行命令
    "show_command": true,


    // ==========================================
    // 8. 文件保存
    // ==========================================

    // 运行前保存文件
    // all：保存所有已编辑文件
    // current：只保存当前文件
    // none：不自动保存
    "save": "current"


    // ==========================================
    // 9. 自动触发钩子（可选）
    // ==========================================

    // 目前支持 create_worktree
    // 新建 Git Worktree 后自动执行任务
    // "hooks": [
    //   "create_worktree"
    // ]
  }
]
